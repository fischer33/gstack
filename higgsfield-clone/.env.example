# Kopiere diese Datei nach .env.local und trage deinen Replicate-Token ein.
# Token erstellen: https://replicate.com/account/api-tokens  (.env.local wird nie committet)
REPLICATE_API_TOKEN=

# Optional
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# REPLICATE_MAX_PER_HOUR=30      # Kostenbremse: maximale Bilder pro Stunde
# PROVIDER=mock                  # erzwingt Platzhalter, auch wenn ein Token gesetzt ist
