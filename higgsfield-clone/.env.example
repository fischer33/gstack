# Kopiere diese Datei nach .env.local (wird nie committet) und starte `npm run dev` neu.

# --- Kostenlos: lokal auf dem Mac (empfohlen) ---
PROVIDER=local
# LOCAL_IMAGE_MODEL=schnell        # mflux-Modell
# LOCAL_IMAGE_LONG_SIDE=768        # längere Bildseite in Pixel (kleiner = schneller, weniger RAM)
# LOCAL_IMAGE_STEPS=4
# LOCAL_IMAGE_QUANTIZE=4           # 4 = wenig RAM (16 GB), 8 = bessere Qualität (mehr RAM)
# LOCAL_TIMEOUT_SEC=900            # der erste Lauf lädt das Modell und dauert länger
# LOCAL_IMAGE_CMD=mflux-generate
# HF_TOKEN=                        # Hugging Face Read-Token, nötig weil FLUX.1-schnell zugangsbeschränkt ist

# --- Optional, kostenpflichtig: Replicate ---
# PROVIDER=replicate
# REPLICATE_API_TOKEN=
# REPLICATE_IMAGE_MODEL=black-forest-labs/flux-schnell
# REPLICATE_MAX_PER_HOUR=30
