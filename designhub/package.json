{
  "name": "designhub",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -n web,api -c magenta,cyan \"npm run dev -w @designhub/web\" \"npm run dev -w @designhub/server\"",
    "build": "npm run build -w @designhub/web && npm run build -w @designhub/server",
    "test": "npm run test -w @designhub/shared -w @designhub/web -w @designhub/server --if-present",
    "typecheck": "npm run typecheck -w @designhub/shared -w @designhub/web -w @designhub/server --if-present",
    "postinstall": "npm run db:generate -w @designhub/server",
    "db:up": "docker compose up -d",
    "db:migrate": "npm run db:migrate -w @designhub/server",
    "db:seed": "npm run db:seed -w @designhub/server"
  },
  "devDependencies": { "concurrently": "^9.0.1", "typescript": "^5.6.3" }
}
