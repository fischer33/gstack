# --- Server ---
DATABASE_URL="postgresql://designhub:designhub@localhost:5432/designhub"
JWT_SECRET="change-me-to-a-long-random-string-0123456789"
WEB_ORIGIN="http://localhost:5173"
PORT=4000

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5173/api/auth/google/callback"

# --- S3-kompatibler Speicher (lokal: MinIO aus docker-compose) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="designhub"
S3_ACCESS_KEY="designhub"
S3_SECRET_KEY="designhub-secret"
S3_PUBLIC_URL="http://localhost:9000/designhub"

# --- Hintergrund entfernen (remove.bg) ---
BG_REMOVAL_API_KEY=""
